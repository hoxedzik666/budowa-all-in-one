# --- Postgres ---
POSTGRES_USER=budowa
POSTGRES_PASSWORD=budowa
POSTGRES_DB=budowa
POSTGRES_PORT=5433

# --- Baza ---
# Bez tej zmiennej: Postgres na komputerze, plik SQLite w Termuxie.
# Podanie jej przebija jedno i drugie.
# DATABASE_URL=postgresql+psycopg://budowa:budowa@localhost:5433/budowa
# DATABASE_URL=sqlite:////data/data/com.termux/files/home/budowa-all-in-one/data/budowa.sqlite3

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=dev-secret-change-me
WEB_PORT=8000
ADMINER_PORT=8080

# --- Logowanie ---
# Konto administratora tworzy komenda: flask utworz-admina
# Zapisuje ona ADMIN_LOGIN i ADMIN_HASLO do pliku .env (ten plik jest w .gitignore).
# W bazie lezy wylacznie skrot hasla - jawnego nie da sie odczytac.
# ADMIN_LOGIN=budowa-adm
# ADMIN_HASLO=<generowane>

# Wylaczyc mozna tylko na czas testow:
# WYMAGAJ_LOGOWANIA=0
REMEMBER_COOKIE_DAYS=14
